{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "aws-lambda"
        ],
        "rootDir": "src",
        "outDir": "dist",
    },
    "include": [
        "src/**/*.ts"
    ]
}